#. Translators: The category name displayed in the input gesture dialog
#: addon\globalPlugins\youtubeDownloadHelper\__init__.py:31
msgid "Youtube download helper"
msgstr "YouTube İndirme Yardımcısı"

#. Translators: Message displayed in input help mode.
#: addon\globalPlugins\youtubeDownloadHelper\__init__.py:39
msgid ""
"Open Savefrom.net site, with the download link for the youtube video on it."
msgstr "İndirme bağlantısını bulabileceğimiz Savefrom.net sitesini açar"

#: addon\globalPlugins\youtubeDownloadHelper\__init__.py:50
msgid "Sorry, but the url is not a valid youtube url"
msgstr "Üzgünüz, bu bağlantı geçerli bir YouTube bağlantısı değil"

#. Add-on summary, usually the user visible name of the addon.
#. Translators: Summary for this add-on
#. to be shown on installation and add-on information found in Add-ons Manager.
#: buildVars.py:23
msgid "Youtube Download Helper"
msgstr "YouTube İndirme Yardımcısı"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-ons manager
#: buildVars.py:26
msgid ""
"This NVDA add-on helps to download youtube videos, with the help of Savefrom."
"net website.\n"
"Just stand on the page of the video you want to download, and press the addon "
"gesture.\n"
"You will be directed to Savefrom.net page, where you find the download link."
msgstr ""
"Bu NVDA eklentisi, SaveFrom.net web sitesinin yardımıyla YouTube videolarını "
"indirmeye yardımcı olur.\n"
"İndirmek istediğiniz videonun sayfasını açın ve eklenti kısayol tuşlarına "
"basın.\n"
"İndirme bağlantısını bulabileceğiniz SaveFrom.net sayfasına "
"yönlendirileceksiniz."
